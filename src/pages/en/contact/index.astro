---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import AnnouncementBar from '../../../components/layout/AnnouncementBar.astro';
---

<BaseLayout
  title="Contact — iNUSUAL"
  description="Contact iNUSUAL to request a proposal."
  lang="en"
>
  <AnnouncementBar />
  <Navbar lang="en" currentPath="/en/contact" />

  <main>

    <section class="contact-hero">
      <div class="container contact-hero__inner">
        <div class="contact-hero__content reveal">
          <span class="contact-eyebrow">Contact</span>
          <h1 class="contact-hero__title">
            Let's talk about your next project
          </h1>
        </div>
        <div class="contact-hero__info reveal reveal-delay-2">
          <div class="contact-detail">
            <span class="contact-detail__label">Email</span>
            <a href="mailto:info@inusual.com" class="contact-detail__value">info@inusual.com</a>
          </div>
          <div class="contact-detail">
            <span class="contact-detail__label">Head office</span>
            <span class="contact-detail__value">A Coruña, Galicia — Spain</span>
          </div>
          <div class="contact-detail">
            <span class="contact-detail__label">Presence</span>
            <span class="contact-detail__value">Spain · Mexico · USA · China</span>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-form-section">
      <div class="contact-form-section__overlay"></div>
      <div class="contact-form-card">

        <div class="contact-form__header reveal">
          <h2 class="contact-form__title">Contact form</h2>
          <p class="contact-form__sub">We are at your disposal to answer questions, provide further information or request a personalised proposal.</p>
        </div>

        <div class="contact__form reveal">

          <div class="form-group">
            <label class="form-label" for="nombre">
              First name <span class="form-required">*</span>
            </label>
            <input class="form-input" type="text" id="nombre" name="nombre" placeholder="Your first name" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="apellidos">
              Last name <span class="form-required">*</span>
            </label>
            <input class="form-input" type="text" id="apellidos" name="apellidos" placeholder="Your last name" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">
              Email <span class="form-required">*</span>
            </label>
            <input class="form-input" type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="telefono">
              Phone <span class="form-required">*</span>
            </label>
            <div class="form-phone">
              <select class="form-input form-select form-prefix" id="prefijo" name="prefijo">
                <option value="+1">🇺🇸 +1</option>
                <option value="+34">🇪🇸 +34</option>
                <option value="+52">🇲🇽 +52</option>
                <option value="+86">🇨🇳 +86</option>
                <option value="+44">🇬🇧 +44</option>
                <option value="+33">🇫🇷 +33</option>
                <option value="+49">🇩🇪 +49</option>
                <option value="+39">🇮🇹 +39</option>
                <option value="+351">🇵🇹 +351</option>
                <option value="+54">🇦🇷 +54</option>
                <option value="+55">🇧🇷 +55</option>
                <option value="+57">🇨🇴 +57</option>
                <option value="+56">🇨🇱 +56</option>
                <option value="+971">🇦🇪 +971</option>
                <option value="+81">🇯🇵 +81</option>
              </select>
              <input class="form-input form-phone-number" type="tel" id="telefono" name="telefono" placeholder="600 000 000" required />
            </div>
          </div>

          <div class="form-group form-group--full">
            <label class="form-label" for="empresa">
              Company <span class="form-optional">optional</span>
            </label>
            <input class="form-input" type="text" id="empresa" name="empresa" placeholder="Your company name" />
          </div>

          <div class="form-group form-group--full">
            <label class="form-label" for="mensaje">
              Tell us about your project <span class="form-required">*</span>
            </label>
            <textarea class="form-input form-textarea" id="mensaje" name="mensaje" rows="6" placeholder="Briefly describe what you need, the space, the objectives..." required></textarea>
          </div>

          <div class="form-group form-group--full">
            <label class="form-label" for="archivos">
              Upload your files <span class="form-optional">optional</span>
            </label>
            <div class="form-dropzone" id="dropzone">
              <input
                class="form-file-input"
                type="file"
                id="archivos"
                name="archivos"
                multiple
                accept=".jpg,.jpeg,.png,.pdf,.xls,.xlsx,.txt,.dwg,.doc,.docx"
              />
              <div class="form-dropzone__content">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                <p class="form-dropzone__text">
                  Drag files here or <span class="form-dropzone__link">browse</span>
                </p>
                <p class="form-dropzone__hint">JPG, PNG, PDF, Excel, TXT, DWG — max. 10MB per file</p>
              </div>
              <ul class="form-file-list" id="file-list"></ul>
            </div>
          </div>

          <div class="form-group form-group--full form-group--submit">
            <button type="button" class="contact__submit" id="submit-btn">
              Request proposal
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <p class="contact__privacy">
              By submitting this form you accept our
              <a href="/privacy">privacy policy</a>.
            </p>
          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer lang="en" />
</BaseLayout>

<style>
.contact-hero {
  background: #fff;
  padding-block: clamp(5rem, 10vw, 9rem);
  border-bottom: 1px solid var(--color-border);
}

.contact-hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(3rem, 6vw, 7rem);
  align-items: end;
}

.contact-eyebrow {
  display: block;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: var(--space-5);
}

.contact-hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 700;
  font-style: normal;
  color: var(--color-text);
  letter-spacing: -0.03em;
  line-height: 1.05;
}

.contact-hero__info {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.contact-detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  border-bottom: 1px solid var(--color-border);
  padding-bottom: var(--space-5);
}

.contact-detail:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.contact-detail__label {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.contact-detail__value {
  font-size: var(--text-base);
  color: var(--color-text);
  text-decoration: none;
  transition: color 0.2s;
}

.contact-detail__value:hover { color: #029788; }

.contact-form-section {
  position: relative;
  padding: clamp(4rem, 8vw, 8rem) clamp(2rem, 6vw, 8rem) clamp(8rem, 15vw, 14rem);
  background-image: url('/contactofondo.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

.contact-form-section__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.1);
  z-index: 0;
}

.contact-form-card {
  position: relative;
  z-index: 1;
  background: #fff;
  padding: clamp(var(--space-8), 5vw, var(--space-16));
  width: 100%;
  max-width: 1000px;
  margin-inline: auto;
}

.contact-form__header {
  margin-bottom: clamp(2rem, 4vw, 4rem);
}

.contact-form__title {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  font-weight: 700;
  font-style: normal;
  color: var(--color-text);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-3);
}

.contact-form__sub {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  max-width: 600px;
  line-height: var(--leading-loose);
}

.contact__form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
  width: 100%;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.form-group--full { grid-column: 1 / -1; }

.form-group--submit {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.form-label {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.form-required { color: #029788; }

.form-optional {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  font-weight: 400;
  background: var(--color-bg-soft);
  padding: 1px 8px;
  border-radius: 4px;
  border: 1px solid var(--color-border);
}

.form-input {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--color-text);
  background: transparent;
  border: none;
  border-bottom: 1.5px solid var(--color-border);
  border-radius: 0;
  padding: var(--space-3) 0;
  transition: border-color var(--duration-fast);
  width: 100%;
  outline: none;
}

.form-input:focus { border-bottom-color: #029788; }
.form-input::placeholder { color: var(--color-text-light); }

.form-phone { display: flex; gap: var(--space-3); }

.form-prefix {
  width: 110px;
  flex-shrink: 0;
  cursor: pointer;
  appearance: none;
}

.form-phone-number { flex: 1; }
.form-select { cursor: pointer; appearance: none; }
.form-textarea { resize: vertical; min-height: 120px; }

.form-dropzone {
  position: relative;
  border: 2px dashed var(--color-border);
  border-radius: 0;
  background: transparent;
  transition: border-color var(--duration-fast);
  cursor: pointer;
}

.form-dropzone:hover,
.form-dropzone.is-dragover { border-color: #029788; }

.form-file-input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.form-dropzone__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-8);
  color: var(--color-text-muted);
  pointer-events: none;
}

.form-dropzone__text { font-size: var(--text-sm); color: var(--color-text-muted); }
.form-dropzone__link { color: #029788; font-weight: 500; text-decoration: underline; }
.form-dropzone__hint { font-size: var(--text-xs); color: var(--color-text-light); }

.form-file-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
}

.form-file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-2) 0;
  font-size: var(--text-xs);
  color: var(--color-text);
}

.form-file-item__name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-file-item__size { color: var(--color-text-muted); flex-shrink: 0; }

.form-file-item__remove {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-muted);
  padding: 0;
  display: flex;
  align-items: center;
  transition: color var(--duration-fast);
}

.form-file-item__remove:hover { color: #e53e3e; }

.contact__submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  background: #029788;
  color: #fff;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--text-base);
  padding: var(--space-4) var(--space-10);
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: all var(--duration-normal) var(--ease-out);
  white-space: nowrap;
}

.contact__submit:hover {
  background: #017a6e;
  box-shadow: 0 8px 32px rgba(2,151,136,0.4);
}

.contact__privacy {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.contact__privacy a {
  color: var(--color-text);
  text-decoration: underline;
}

@media (max-width: 900px) {
  .contact-hero__inner { grid-template-columns: 1fr; }
  .contact__form { grid-template-columns: 1fr; }
  .contact-form-section {
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem);
    background-attachment: scroll;
  }
}

@media (max-width: 480px) {
  .form-phone { flex-direction: column; }
  .form-prefix { width: 100%; }
  .form-group--submit { flex-direction: column; align-items: flex-start; }
}
</style>

<script>
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('archivos') as HTMLInputElement;
  const fileList = document.getElementById('file-list');
  let files: File[] = [];

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function renderFiles() {
    if (!fileList) return;
    fileList.innerHTML = '';
    files.forEach((file, i) => {
      const li = document.createElement('li');
      li.className = 'form-file-item';
      li.innerHTML = `
        <span class="form-file-item__name">${file.name}</span>
        <span class="form-file-item__size">${formatSize(file.size)}</span>
        <button class="form-file-item__remove" data-index="${i}" aria-label="Remove">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      `;
      fileList.appendChild(li);
    });
  }

  fileInput?.addEventListener('change', () => {
    const newFiles = Array.from(fileInput.files ?? []);
    files = [...files, ...newFiles];
    renderFiles();
  });

  fileList?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-index]') as HTMLElement;
    if (btn) {
      const idx = parseInt(btn.dataset.index ?? '0');
      files.splice(idx, 1);
      renderFiles();
    }
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('is-dragover');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('is-dragover');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('is-dragover');
    const dropped = Array.from(e.dataTransfer?.files ?? []);
    files = [...files, ...dropped];
    renderFiles();
  });
</script>