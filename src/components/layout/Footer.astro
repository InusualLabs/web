---
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<div class="footer__spacer"></div>

<footer class="footer">
  <div class="footer__card">

    <div class="footer__card-top">
      <h2 class="footer__title">
        {isEs ? 'Hablemos!' : "Let's talk!"}
      </h2>

      <nav class="footer__nav">
        <a href="/" class="footer__nav-link">{isEs ? 'Inicio' : 'Home'}</a>
        <span class="footer__nav-sep">/</span>
        <a href="/proyectos" class="footer__nav-link">{isEs ? 'Proyectos' : 'Projects'}</a>
        <span class="footer__nav-sep">/</span>
        <a href="/sobre-nosotros" class="footer__nav-link">{isEs ? 'Sobre nosotros' : 'About us'}</a>
        <span class="footer__nav-sep">/</span>
        <a href="/contacto" class="footer__nav-link">{isEs ? 'Contacto' : 'Contact'}</a>
      </nav>
    </div>

    <div class="footer__card-bottom">
      <a href={isEs ? '/' : '/en'} class="footer__logo-link">
        <img src="/logo.svg" alt="Inusual.labs" class="footer__logo-img" />
      </a>

      <div class="footer__social">
        <a href="https://instagram.com/inusual" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a href="https://linkedin.com/company/inusual" class="footer__social-link" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Legal bar -->
    <div class="footer__legal-bar">
      <p class="footer__copy">
        © 2026 Inusual.labs — Inusual Comunicación Innovadora S.L. {isEs ? 'Todos los derechos reservados.' : 'All rights reserved.'}
      </p>
      <div class="footer__legal">
        <a href="/legal" class="footer__legal-link">{isEs ? 'Aviso legal' : 'Legal notice'}</a>
        <a href="/privacidad" class="footer__legal-link">{isEs ? 'Política de privacidad' : 'Privacy policy'}</a>
        <a href="/cookies" class="footer__legal-link">{isEs ? 'Política de cookies' : 'Cookie policy'}</a>
      </div>
    </div>

  </div>
</footer>

<style>
.footer__spacer {
  height: clamp(15rem, 22vw, 22rem);
  background: transparent;
}

.footer {
  background: transparent;
  padding-inline: clamp(1.5rem, 4vw, 5rem);
  padding-bottom: 0;
}

.footer__card {
  background: linear-gradient(135deg, #029788, #00D4C8, #029788);
  background-size: 400% 400%;
  animation: gradient-shift 20s ease infinite;
  border-radius: 0;
  padding: clamp(4rem, 7vw, 8rem) clamp(2rem, 6vw, 8rem) clamp(2rem, 4vw, 4rem);
  display: flex;
  flex-direction: column;
  width: 100%;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

.footer__card-top {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
  margin-bottom: clamp(4rem, 8vw, 8rem);
}

.footer__title {
  font-family: var(--font-display);
  font-size: clamp(4rem, 10vw, 8rem);
  font-weight: 700;
  font-style: normal;
  color: #fff;
  line-height: 1;
  letter-spacing: -0.03em;
}

.footer__nav {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.footer__nav-link {
  font-family: var(--font-display);
  font-size: clamp(var(--text-lg), 2.5vw, var(--text-2xl));
  font-weight: 500;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  transition: color 0.2s;
}

.footer__nav-link:hover {
  color: #0A0A0A;
}

.footer__nav-sep {
  color: rgba(255,255,255,0.4);
  font-size: clamp(var(--text-lg), 2.5vw, var(--text-2xl));
}

.footer__card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: clamp(2rem, 4vw, 4rem);
}

.footer__logo-link {
  display: block;
}

.footer__logo-img {
  height: 36px;
  width: auto;
  filter: brightness(0) invert(1);
}

.footer__social {
  display: flex;
  align-items: center;
  gap: var(--space-6);
}

.footer__social-link {
  color: rgba(255,255,255,0.85);
  transition: color 0.2s;
  display: flex;
  align-items: center;
}

.footer__social-link:hover {
  color: #0A0A0A;
}

.footer__social-link svg {
  shape-rendering: geometricPrecision;
}

/* Legal bar */
.footer__legal-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
  padding-top: var(--space-6);
  border-top: 1px solid rgba(255,255,255,0.2);
}

.footer__copy {
  font-size: var(--text-xs);
  color: rgba(255,255,255,0.6);
}

.footer__legal {
  display: flex;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.footer__legal-link {
  font-size: var(--text-xs);
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  transition: color 0.2s;
}

.footer__legal-link:hover {
  color: #0A0A0A;
}

@media (max-width: 768px) {
  .footer__card-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .footer__legal-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .footer__title {
    font-size: clamp(3rem, 14vw, 5rem);
  }
}
</style>