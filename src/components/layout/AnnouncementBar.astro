---
interface Props {
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
---

<div class="announcement-bar">
  <div class="container announcement-bar__inner">

    <!-- Redes sociales -->
    <div class="announcement-bar__social">
      <a href="https://instagram.com/inusual" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
      <a href="https://linkedin.com/company/inusual" class="announcement-bar__social-link" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>

    <div class="announcement-bar__divider"></div>

    <!-- Contacto -->
    <div class="announcement-bar__contact">
      <a href="mailto:info@inusualcom.com" class="announcement-bar__contact-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        info@inusualcom.com
      </a>
      <span class="announcement-bar__sep">·</span>
      <a href="tel:+34981073079" class="announcement-bar__contact-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
        </svg>
        +34 981 07 30 79
      </a>
    </div>

  </div>
</div>

<style>
.announcement-bar {
  background: linear-gradient(135deg, #029788, #00D4C8, #029788);
  background-size: 400% 400%;
  animation: gradient-shift 20s ease infinite;
  color: #fff;
  font-size: var(--text-sm);
  padding-block: var(--space-2);
  position: relative;
  z-index: var(--z-sticky);
}

.announcement-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5);
  flex-wrap: wrap;
}

.announcement-bar__social {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.announcement-bar__social-link {
  color: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  transition: color 0.2s;
}

.announcement-bar__social-link:hover {
  color: #fff;
}


.announcement-bar__contact {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.announcement-bar__contact-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  color: rgba(255,255,255,0.85);
  font-size: var(--text-xs);
  text-decoration: none;
  transition: color 0.2s;
  white-space: nowrap;
}

.announcement-bar__contact-link:hover {
  color: #fff;
}

.announcement-bar__sep {
  color: rgba(255,255,255,0.3);
  font-size: var(--text-xs);
}

@media (max-width: 640px) {
  .announcement-bar__divider { display: none; }
  .announcement-bar__inner { gap: var(--space-3); }
}
</style>