---
interface Props {
  headline1: string;
  subheadline: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary: { label: string; href: string };
  clientsLabel: string;
  lang?: 'es' | 'en';
}
const { headline1, subheadline, ctaPrimary, ctaSecondary, clientsLabel, lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section class="hero">

  <!-- Flotantes izquierda -->
  <div class="hero__side hero__side--left">
    <div class="hero__float-card">
      <div class="hero__float-avatar">T</div>
      <div>
        <strong>Tracking</strong>
        <span>Disponible</span>
      </div>
      <span class="hero__float-dot"></span>
    </div>
    <div class="hero__float-card">
      <div class="hero__float-avatar hero__float-avatar--dark">M</div>
      <div>
        <strong>Monitorización</strong>
        <span>Activa</span>
      </div>
      <span class="hero__float-dot"></span>
    </div>
  </div>

  <!-- Contenido central -->
  <div class="container hero__inner">
    <div class="hero__content">

      <div class="hero__badge reveal">
        <span class="hero__badge-dot"></span>
        <span>Sistemas Iot - Ingeniería - I+D+i</span>
      </div>

      <h1 class="hero__headline reveal reveal-delay-1">
        {headline1}
      </h1>

      <p class="hero__subheadline reveal reveal-delay-2">{subheadline}</p>

      <div class="hero__actions reveal reveal-delay-3">
        <a href={ctaPrimary.href} class="btn btn--hero-primary">
          {ctaPrimary.label}
        </a>
        <a href={ctaSecondary.href} class="btn btn--hero-secondary">
          {ctaSecondary.label}
        </a>
      </div>

    </div>
  </div>

  <!-- Flotantes derecha -->
  <div class="hero__side hero__side--right">
    <div class="hero__float-card">
      <div class="hero__float-icon">📍</div>
      <div>
        <strong>4 países</strong>
        <span>presencia global</span>
      </div>
    </div>
    <div class="hero__float-card">
      <div class="hero__float-icon">⚡</div>
      <div>
        <strong>+200 proyectos</strong>
        <span>completados</span>
      </div>
    </div>
  </div>

</section>

<style>
.hero {
  position: relative;
  padding-top: clamp(var(--space-20), 10vw, var(--space-32));
  padding-bottom: clamp(var(--space-20), 10vw, var(--space-32));
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 900px;
  height: 900px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  pointer-events: none;
  opacity: 0.5;
}

.hero::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 580px;
  height: 580px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  pointer-events: none;
  opacity: 0.5;
}

.hero__inner {
  position: relative;
  z-index: 2;
  width: 100%;
}

.hero__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 780px;
  margin-inline: auto;
}

/* Badge */
.hero__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-bg-soft);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-6);
}

.hero__badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #029788;
  box-shadow: 0 0 8px #029788;
  animation: pulse 2s infinite;
  flex-shrink: 0;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

/* Headline */
.hero__headline {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 6vw, 4.5rem);
  font-weight: 600;
  font-style: normal;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-bottom: var(--space-6);
}

/* Subheadline */
.hero__subheadline {
  font-size: clamp(var(--text-base), 2vw, var(--text-md));
  color: var(--color-text-muted);
  line-height: var(--leading-loose);
  max-width: 560px;
  margin-bottom: var(--space-8);
  font-style: normal;
}

/* Actions */
.hero__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.btn--hero-primary {
  background: linear-gradient(135deg, #029788, #00D4C8, #029788);
  background-size: 400% 400%;
  animation: gradient-shift 20s ease infinite;
  color: #fff;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--text-base);
  padding: var(--space-4) var(--space-8);
  border-radius: 2px;
  transition: all var(--duration-normal) var(--ease-out);
  text-decoration: none;
}

.btn--hero-primary:hover {
  background: #017a6e;
  box-shadow: 0 8px 32px rgba(2,151,136,0.35);
  transform: translateY(-1px);
}

.btn--hero-secondary {
  display: inline-flex;
  align-items: center;
  background: var(--color-bg-dark);
  color: #fff;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--text-base);
  padding: var(--space-4) var(--space-8);
  border-radius: 2px;
  transition: all var(--duration-fast) var(--ease-out);
  text-decoration: none;
}

.btn--hero-secondary:hover {
  background: #222;
  transform: translateY(-1px);
}

/* Sides */
.hero__side {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  z-index: 3;
}

.hero__side--left {
  left: clamp(2rem, 5vw, 6rem);
  align-items: flex-start;
  margin-top: -20px;
}

.hero__side--right {
  right: clamp(2rem, 5vw, 6rem);
  align-items: flex-end;
  margin-top: 20px;
}

/* Mosaico diagonal */
.hero__side--left {
  left: clamp(2rem, 5vw, 6rem);
  align-items: flex-start;
  margin-top: -60px;
}

.hero__side--right {
  right: clamp(2rem, 5vw, 6rem);
  align-items: flex-end;
  margin-top: 60px;
}

.hero__side--left .hero__float-card:nth-child(2) {
  margin-left: 80px;
  animation: float-left-2 3.4s ease-in-out infinite;
  animation-delay: 1.2s;
}

.hero__side--right .hero__float-card:nth-child(2) {
  margin-right: 80px;
  animation: float-right-2 3.4s ease-in-out infinite;
  animation-delay: 1.8s;
}

@keyframes float-left-1 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
@keyframes float-left-2 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
@keyframes float-right-1 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
@keyframes float-right-2 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* Float cards */
.hero__float-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
  box-shadow: var(--shadow-xl);
  border: 1px solid var(--color-border);
  white-space: nowrap;
}

.hero__float-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #029788;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-sm);
  font-weight: 600;
  flex-shrink: 0;
}

.hero__float-avatar--dark {
  background: var(--color-bg-dark);
}

.hero__float-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #029788;
  box-shadow: 0 0 6px #029788;
  flex-shrink: 0;
}

.hero__float-icon {
  font-size: var(--text-lg);
  flex-shrink: 0;
}

.hero__float-card div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero__float-card strong {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.hero__float-card span {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

/* Responsive */
@media (max-width: 1100px) {
  .hero__side { display: none; }
}

@media (max-width: 480px) {
  .hero__actions { flex-direction: column; width: 100%; }
  .btn--hero-primary, .btn--hero-secondary { justify-content: center; }
}
</style>
