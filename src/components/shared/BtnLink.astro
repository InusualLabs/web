---
export interface Props {
  href: string;
  text: string;
  className?: string;
  variant: "primary" | "secondary" | "cta";
}

const { href, text, className, variant } = Astro.props;

const getThemeStyle = (variant: "primary" | "secondary" | "cta") => {
  if (variant === "primary") {
    return "bg-primary border-primary hover:bg-white hover:border-primary";
  }
  if (variant === "secondary") {
    return "bg-secondary border-secondary hover:bg-white hover:border-secondary";
  }
  if (variant === "cta") {
    return "bg-cta border-cta hover:bg-white hover:border-cta";
  }
  return "";
};

const getTextColor = (variant: "primary" | "secondary" | "cta") => {
  if (variant === "primary") {
    return "text-white hover:text-primary font-medium";
  }
  if (variant === "secondary") {
    return "text-white hover:text-secondary font-medium";
  }
  if (variant === "cta") {
    return "text-white hover:text-primary font-medium";
  }
  return "";
};

const base = "rounded-full outline-none relative overflow-hidden px-6 py-3 border-2";
const animation = "duration-300 ease-linear";

const classes = `${base} ${animation} ${getTextColor(variant)} ${getThemeStyle(variant)} ${className ?? ""}`;
---

<a href={href} class={classes}>
  <span class="relative z-10">
    {text}
  </span>
</a>
