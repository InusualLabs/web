---
export interface Props {
  className?: string;
  color: "primary" | "secondary" | "cta";
  variant: "solid" | "outline" | "gradient";
}

const { className = "", color = "primary", variant = "solid" } = Astro.props;

const getVariantStyle = (
  variant: "solid" | "outline" | "gradient" = "solid",
  color: "primary" | "secondary" | "cta" = "primary"
) => {
  let classList = "";
  if (variant === "solid") {
    classList = `border-transparent `;
    if (color === "primary") {
      classList += `bg-primary-500 hover:bg-white hover:border-primary-500 active:bg-white disabled:bg-primary-200 `;
      classList += `text-white hover:text-primary-500 disabled:text-primary-700 `;
    } else if (color === "secondary") {
      classList += `bg-secondary-500 hover:bg-white hover:border-secondary-500 active:bg-white disabled:bg-secondary-200 `;
      classList += `text-white hover:text-secondary-500 disabled:text-secondary-700 `;
    } else if (color === "cta") {
      classList += `bg-cta-500 hover:bg-white hover:border-cta-500 active:bg-white disabled:bg-cta-200 `;
      classList += `text-white hover:text-cta-500 disabled:text-cta-700 `;
    }
    return classList;
  }
  if (variant === "outline") {
    classList = ` `;
    if (color === "primary") {
      classList += `border-primary-500 bg-transparent hover:bg-white active:bg-white `;
      classList += `text-primary-500 hover:text-primary-500 `;
    } else if (color === "secondary") {
      classList += `border-secondary-500 bg-transparent hover:bg-white active:bg-white `;
      classList += `text-secondary-500 hover:text-secondary-500 `;
    } else if (color === "cta") {
      classList += `border-cta-500 bg-transparent hover:bg-white active:bg-white `;
      classList += `text-cta-500 hover:text-cta-500 `;
    }
    return classList;
  }
  if (variant === "gradient") {
    classList = `border-transparent `;
    if (color === "primary") {
      classList += `bg-primary-500 hover:bg-white hover:border-primary-500 active:bg-white disabled:bg-primary-200 `;
      classList += `text-white hover:text-primary-500 disabled:text-primary-700 `;
    } else if (color === "secondary") {
      classList += `bg-secondary-500 hover:bg-white hover:border-secondary-500 active:bg-white disabled:bg-secondary-200 `;
      classList += `text-white hover:text-secondary-500 disabled:text-secondary-700 `;
    } else if (color === "cta") {
      classList += `bg-cta-500 hover:bg-white hover:border-cta-500 active:bg-white disabled:bg-cta-200 `;
      classList += `text-white hover:text-cta-500 disabled:text-cta-700 `;
    }
    return classList;
  }
};

const base =
  "rounded-full outline-none relative overflow-hidden px-6 py-3 border";
const animation = `duration-300 ease-linear`;
---

<button
  class={`
   ${base} 
    ${animation}
    ${getVariantStyle(variant, color)}
    ${className}
  `}
>
  <slot />
</button>